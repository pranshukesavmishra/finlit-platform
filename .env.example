# Copy to .env (never commit .env). Generate secrets with:  openssl rand -base64 32
ENVIRONMENT=development            # production enables the startup safety checks
FINEDGE_API_KEY=
FINEDGE_MODE=live                  # live | fixtures (offline, recorded RELIANCE payloads)
FINEDGE_CONCURRENCY=8

POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Production: the API connects as the read-only role (create it as shown in deploy/README.md)
# API_DATABASE_URL=postgresql://finlit_api_user:PASSWORD@db:5432/finlit

# Used only when running outside docker compose:
DATABASE_URL=postgresql://finlit:PASSWORD@localhost:5432/finlit
REDIS_URL=redis://:PASSWORD@localhost:6379/0

ALLOWED_HOSTS=localhost,127.0.0.1                  # production: api.finlitventures.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173   # production: https://finlitventures.com,https://www.finlitventures.com
CLIENT_IP_HEADER=                                  # production behind Cloudflare: cf-connecting-ip; on Render: x-forwarded-for (set by deploy/render-start.sh)
TRUSTED_PROXIES=                                   # extra proxy ranges (CIDR, comma-separated) skipped when reading x-forwarded-for; private and Cloudflare ranges are built in.
                                                   # Check: the admin console's Data health shows the address the server sees for you.
RATE_LIMIT_PER_MINUTE=300
QUEUE_LIMIT_PER_HOUR=30
QUEUE_MAX_PENDING=500
FUNDAMENTALS_TTL_HOURS=24

# Accounts (sign-in, sessions, plans)
PUBLIC_SITE_URL=http://localhost:5173              # production: https://finlitventures.com (used in email links)
SECRET_KEY=                                        # production: openssl rand -base64 48  (encrypts authenticator secrets; never change without re-enrolling MFA)
MAIL_MODE=console                                  # console (dev: writes to the outbox table) | resend (production)
RESEND_API_KEY=
MAIL_FROM=FinLit Ventures <hello@finlitventures.com>
SHOWCASE_SYMBOLS=RELIANCE                          # companies shown in full to everyone (the free example)
COOKIE_SAMESITE=lax                                # staging without a domain only: none

# FinLit Prism (Gold plan's financial-health rating). Full guide: docs/prism/DEPLOY.md
# It needs the site backend (site-api/backend) running, with FINEDGE_API_KEY (above) and the SAME CMS_JWT_SECRET as this API.
SITE_API_URL=                                      # blank on Render (found automatically, 127.0.0.1:8001); locally http://127.0.0.1:8001
CMS_JWT_SECRET=                                    # 32+ characters, identical here and in the site backend: openssl rand -base64 48
MONGO_URL=                                         # optional for Prism; the blog/CMS, portfolio uploads and forms need it
UPSTOX_ACCESS_TOKEN=                               # optional: second data source for gaps in FinEdge's statements (expires daily)
PREMIUM_GENERATION_SLOTS=2                         # site backend: reports calculated at once (1 on a 512 MB host)
STOCK_FUNDAMENTALS_CACHE_ENTRIES=32                # site backend: provider data kept in memory
SITE_API_START=auto                                # deploy/render-start.sh: auto | never | always
