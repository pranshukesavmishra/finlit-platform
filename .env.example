# Copy to .env (never commit .env).
FINEDGE_API_KEY=
# live | fixtures  (fixtures = offline, serves recorded RELIANCE payloads)
FINEDGE_MODE=live
FINEDGE_CONCURRENCY=8
POSTGRES_PASSWORD=change-me
# Used only when running outside docker compose:
DATABASE_URL=postgresql://finlit:change-me@localhost:5432/finlit
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://finlitventures.com,https://www.finlitventures.com
FUNDAMENTALS_TTL_HOURS=24
